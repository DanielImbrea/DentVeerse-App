# Copy to .env and fill in per-environment values.
# NEVER commit the real .env file. See docs/01-architecture.md §4 and
# docs/15-ai-agent-instructions.md rule 17-18.

# --- Supabase (per environment: dev / staging / prod are SEPARATE projects) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NEXT_PUBLIC_ variants are required by apps/admin and apps/web (Next.js only
# exposes env vars prefixed NEXT_PUBLIC_ to client-side code) — same values
# as SUPABASE_URL/SUPABASE_ANON_KEY above, duplicated under this prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://dentveerse.com
EXPO_PUBLIC_SITE_URL=https://dentveerse.com
# Service-role key: server-side / Edge Function secrets ONLY. Never in client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- Auth providers ---
GOOGLE_OAUTH_CLIENT_ID=
APPLE_SERVICES_ID=

# --- Push ---
EXPO_PUBLIC_PROJECT_ID=

# --- Media pipeline (Mux) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Set after creating the webhook in the Mux dashboard pointing at your
# deployed mux-webhook function — Mux shows you this secret at that point.
MUX_WEBHOOK_SECRET=

# --- Analytics (PostHog) ---
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Email ---
RESEND_API_KEY=

# --- Payments (not used until the Monetization Phase — see docs/09-subscriptions-payments.md) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anti-abuse (Cloudflare Turnstile) ---
# Site key is PUBLIC (client-side, embedded in the CAPTCHA widget).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFDJMlWn3V3XcAui
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFDJMlWn3V3XcAui
# Secret key is SERVER-ONLY (Edge Function secret for supabase/functions/verify-captcha).
TURNSTILE_SECRET_KEY=

# --- Error monitoring (Sentry) ---
# Get a free DSN at https://sentry.io — one project per app is recommended
# (mobile / web / admin) so errors aren't mixed across very different
# runtimes, though a single DSN works fine to start.
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
